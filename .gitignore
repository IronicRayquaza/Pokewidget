# Captured device logs. `crash_log.txt` alone was 89 MB of UTF-16 logcat, which
# bloats every clone forever for something only useful while a bug is open.
crash_log.txt
pid*.log
*.logcat

# Signing. The keystore lives outside the repo and its passwords are read from
# `keystore.properties`; see `keystore.properties.example`. On a public repo a leaked
# signing key is unrecoverable — every future update would have to be a fresh install.
keystore.properties
*.jks
*.keystore
