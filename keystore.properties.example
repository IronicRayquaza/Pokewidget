# Copy to `keystore.properties` and fill in. That file is gitignored and must stay that way.
#
# Create the keystore once, outside the repo, and back it up somewhere that is not this
# machine. This key signs every future update: lose it and no existing install can ever be
# updated in place again — every tester has to uninstall and lose their configured widgets.
#
#   keytool -genkeypair -v -keystore C:/Users/<you>/keys/pokewidget-upload.jks \
#     -alias pokewidget -keyalg RSA -keysize 4096 -validity 10000
#
# Only `assembleRelease` reads this. `assembleDebug` and the unit tests work without it, so a
# fresh clone builds and tests with no key at all.

storeFile=C:/Users/<you>/keys/pokewidget-upload.jks
storePassword=
keyAlias=pokewidget
keyPassword=
